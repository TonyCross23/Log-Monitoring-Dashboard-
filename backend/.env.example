NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/log_monitoring
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Generate two DIFFERENT secrets: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=log-monitoring-api
JWT_ACCESS_AUDIENCE=log-monitoring-dashboard
JWT_REFRESH_AUDIENCE=log-monitoring-refresh
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
# Comma-separated trusted proxy IPs/CIDRs only; empty means no proxy.
TRUST_PROXY=
LOG_LEVEL=info

# Optional CEIR Swagger availability monitor. Keep credentials on the backend only.
SWAGGER_USER=
SWAGGER_PASSWORD=
CEIR_CHECK_INTERVAL_SECONDS=60
CEIR_CHECK_TIMEOUT_MS=8000
